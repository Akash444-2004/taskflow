# Docker Compose environment.
# Copy this file to .env in the repository root before running docker compose.
# Never commit the real .env file.

APP_PORT=8080

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Must be Base64 that decodes to at least 64 bytes (512 bits) for HS512.
# Generate with:
#   $bytes = New-Object byte[] 64
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
JWT_SECRET=replace-with-a-base64-encoded-512-bit-secret
JWT_ISSUER=taskflow-api

# Origin allowed by CORS and used to build the refresh cookie policy.
# With the bundled nginx reverse proxy, the browser origin is the published APP_PORT.
FRONTEND_URL=http://localhost:8080

# Set to true whenever the app is served over HTTPS.
COOKIE_SECURE=false

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
