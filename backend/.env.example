# Copy this file to backend/.env ONLY if you want to override defaults.
# Normally you do NOT need this file: the run scripts (or the VS Code tasks)
# supply DB credentials and the JWT secret at runtime.
# Never commit backend/.env or real credentials.

# Defaults already match the run scripts; DB_URL and DB_USERNAME are optional.
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USERNAME=postgres
# DB_PASSWORD is prompted at runtime (VS Code quick input / masked terminal prompt).
# Do not write it here.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# JWT_SECRET is generated on first run and stored DPAPI-encrypted in .dev/jwt.secret.
# Only set it here if you deploy somewhere without the run scripts.
# Generate with PowerShell:
# $bytes = New-Object byte[] 64
# [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
# [Convert]::ToBase64String($bytes)
# Must decode to at least 64 bytes (512 bits) because access tokens use HS512.
# JWT_SECRET=replace-with-a-base64-encoded-512-bit-secret
JWT_ISSUER=taskflow-api
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# Set to true when served over HTTPS in production.
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=taskflow_refresh
REFRESH_COOKIE_PATH=/api/auth
